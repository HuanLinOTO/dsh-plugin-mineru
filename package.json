{
  "name": "@dsh-external/dsh-mineru",
  "version": "0.1.0",
  "description": "DSH plugin exposing MineRU document parsing tools to the model.",
  "type": "module",
  "license": "BSD-3-Clause",
  "private": true,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsdown --config tsdown.config.ts",
    "prepare": "tsdown --config tsdown.prepare.config.ts"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
